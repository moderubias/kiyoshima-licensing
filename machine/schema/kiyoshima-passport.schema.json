{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:kiyoshima:schema:license-passport:1.2",
  "title": "Kiyoshima License Passport",
  "type": "object",
  "required": [
    "format",
    "schema_version",
    "declaration_scope",
    "project",
    "profile",
    "license",
    "permissions",
    "ai",
    "rights_reservations",
    "permission_requests",
    "automation",
    "protocol",
    "policy_constraints"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "format": {
      "const": "Kiyoshima License Passport"
    },
    "schema_version": {
      "const": "1.2"
    },
    "declaration_scope": {
      "enum": [
        "covered-software",
        "framework-canonical-license"
      ]
    },
    "project": {
      "type": "object",
      "required": [
        "name",
        "kind"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "repository": {
          "type": "string"
        },
        "copyright_holder": {
          "type": "string"
        },
        "contact": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "profile": {
      "enum": [
        "open",
        "source",
        "commercial",
        "framework"
      ]
    },
    "license": {
      "type": "object",
      "required": [
        "name",
        "canonical_id",
        "spdx_expression",
        "version",
        "authoritative_file",
        "legal_priority",
        "sha256"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "canonical_id": {
          "type": "string"
        },
        "spdx_expression": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "authoritative_file": {
          "type": "string"
        },
        "legal_priority": {
          "const": "license-text-controls"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$"
        }
      },
      "additionalProperties": true
    },
    "repository_licensing": {
      "type": "object",
      "additionalProperties": true
    },
    "permissions": {
      "type": "object",
      "additionalProperties": {
        "enum": [
          "allowed",
          "allowed-with-conditions",
          "agreement-required",
          "permission-required",
          "reserved",
          "not-granted"
        ]
      }
    },
    "ai": {
      "type": "object",
      "additionalProperties": {
        "type": [
          "string",
          "boolean"
        ]
      }
    },
    "rights_reservations": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "permission_requests": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": true
    },
    "automation": {
      "type": "object",
      "required": [
        "conflict_policy",
        "missing_field_policy",
        "unknown_value_policy",
        "machine_metadata_authority",
        "additional_permissions_require_authenticated_grant"
      ],
      "properties": {
        "conflict_policy": {
          "const": "deny-on-conflict"
        },
        "missing_field_policy": {
          "const": "do-not-infer-rights"
        },
        "unknown_value_policy": {
          "const": "do-not-infer-rights"
        },
        "machine_metadata_authority": {
          "const": "informational"
        },
        "additional_permissions_require_authenticated_grant": {
          "const": true
        }
      },
      "additionalProperties": true
    },
    "grants": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "protocol": {
      "type": "object",
      "required": [
        "name",
        "version",
        "semantics",
        "canonical_repository"
      ],
      "properties": {
        "name": {
          "const": "Kiyoshima License Passport Protocol"
        },
        "version": {
          "const": "1.0"
        },
        "semantics": {
          "const": "fail-closed-informational"
        },
        "canonical_repository": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    },
    "policy_constraints": {
      "type": "object",
      "required": [
        "organization_evaluation_days",
        "organization_evaluation_nonproduction_only",
        "distribution_attribution_required",
        "modified_portions_source_required",
        "downstream_rights",
        "operational_ai_provider_must_not_acquire_reserved_rights"
      ],
      "properties": {
        "organization_evaluation_days": {
          "type": "integer",
          "minimum": 0
        },
        "organization_evaluation_nonproduction_only": {
          "type": "boolean"
        },
        "distribution_attribution_required": {
          "type": "boolean"
        },
        "modified_portions_source_required": {
          "type": "boolean"
        },
        "downstream_rights": {
          "const": "direct-from-licensor-not-sublicensed"
        },
        "operational_ai_provider_must_not_acquire_reserved_rights": {
          "type": "boolean"
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
